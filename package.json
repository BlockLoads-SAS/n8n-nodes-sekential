{
	"name": "@blockloads/n8n-nodes-sekential",
	"version": "0.2.1",
	"description": "Official n8n community node for the Sekential API",
	"license": "MIT",
	"homepage": "https://sekential.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"sekential",
		"workflow-automation"
	],
	"author": {
		"name": "Yoann Poupart",
		"email": "yoann.poupart@blockloads.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BlockLoads-SAS/n8n-nodes-sekential.git"
	},
	"bugs": {
		"url": "https://github.com/BlockLoads-SAS/n8n-nodes-sekential/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test tests/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SekentialApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sekential/Sekential.node.js",
			"dist/nodes/Sekential/SekentialTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
